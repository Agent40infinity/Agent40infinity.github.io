@page "/"
@inject HttpClient http
@inject IJSRuntime js
@inject NavigationManager NavManager

<script src='js/Main.js'></script>

<VolumeSlider />
<Return />
<video class="background" autoplay muted loop>
    <source src="Resources/Media/Main.mp4" type="video/mp4">
</video>
<Header />
<main class="content">
    <Banner />
    <section class="information">
        <article class="chapter" id="chapter1">
            <h2 class="title">About Me</h2>
            <img class="visual" src="Resources/pfp.jpg" alt="It's Me.'">
            <p class="about">
                Hi I'm Aiden, a Game Developer and Software Engineer currently working at Red Cartel. Previously, I worked for Powercor Australia and have completed a Bachelor of Game Development at Macquarie University. <br>
                Currently, I'm working full-time while maintaining and publishing editor tools on the <a href="https://assetstore.unity.com/publishers/75209">Unity Asset Store</a> alongside personal projects "Dark Light" and "HG/SS Remake".
            </p>
            <p class="about">
                This portfolio is designed to show off my most prominent works to date from age 13.
                These game development projects range from professional full-time work to indie and include in-development and finished works.
            </p>
            <p class="about">
                This page is dedicated to my desire to express creativity and improvement over well-designed complex systems and tools. To view more in-depth
                details about each project, click the cards below.
            </p>
            <p class="about">
                <a @onclick="@(() => Navigation.NavigateTo(NavManager, js, "/projects/Resume"))">
                    <img class="cv" src="Resources/SVGs/Resume.svg" alt="Resume SVG" />
                </a>
            </p>
            <img class="arrow" src="Resources/SVGs/ArrowDown_Icon.svg" alt="Arrow Down" />
        </article>
        @if (Data.Projects.Count > 0)
        {
            <article class="chapter" id="chapter2">
                <h2 class="title">Professional Work</h2>
                <ProjectContainer Projects="@Data.Projects["professional"]" />
                <img class="arrow" src="Resources/SVGs/ArrowDown_Icon.svg" alt="Arrow Down" />
            </article>
            <article class="chapter" id="chapter3">
                <h2 class="title">Personal Work</h2>
                <ProjectContainer Projects="@Data.Projects["personal"]" />
                <img class="arrow" src="Resources/SVGs/ArrowDown_Icon.svg" alt="Arrow Down" />
            </article>
        }
    </section>
</main>
<Footer />

@code {
    protected override async Task OnInitializedAsync()
    {
        if (Data.Projects != null)
        {
            #pragma warning disable CS8601
            Data.Projects = await http.GetFromJsonAsync<Dictionary<string, List<Project>>>("Data/Projects.json");
            #pragma warning restore CS8601
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            Console.WriteLine("Rendered");
            await js.InvokeVoidAsync("Rendered", Navigation.duration);
        }

        await base.OnAfterRenderAsync(firstRender);
    }
}

<style>
    * {
        font-family: 'Perpetua';
        margin: 0px;
        padding: 0px;
    }

    body {
        overflow-x: hidden;
        overflow-y: hidden;
        background-color: black;
    }

    .hidden {
        opacity: 0;
    }

    hr {
        margin: auto;
    }

    .title {
        font-size: 48px;
    }

    .subtext {
        font-size: 36px;
    }

    video.background {
        position: absolute;
        top: 50%;
        left: 50%;
        min-width: 100%;
        min-height: 100%;
        transform: translateX(-50%) translateY(-50%);
        z-index: -1;
    }

    .menu {
        height: 25px;
        width: 25px;
        filter: invert(100%);
        cursor: pointer;
    }

    .menu:hover {
        filter: invert(71%) sepia(3%) saturate(25%) hue-rotate(332deg) brightness(89%) contrast(97%);
    }

    hr {
        width: 0;
        overflow: hidden;
        border-bottom: solid 4px white;
        border-top-width: 0px;
    }

    .arrow {
        display: inline-block;
        transform: scale(1.5);
        filter: invert(100%);
        cursor: pointer;
        padding: 20px;
    }

    .cv {
        display: inline-block;
        width: 64px;
        height: auto;
        filter: invert(100%);
        cursor: pointer;
        padding-top: 0px;
    }

    .arrow:hover{
        filter: invert(71%) sepia(3%) saturate(25%) hue-rotate(332deg) brightness(89%) contrast(97%);
    }

    .cv:hover {
        filter: invert(90%) sepia(3%) saturate(25%) hue-rotate(332deg) brightness(89%) contrast(97%);
    }

    .information {
        padding: 110px 0px 10% 0px;
        color: white;
        background-color: rgba(0, 0, 0, 0.623);
        display: none;
    }

    .chapter {
        width: 80%;
        text-align: center;
        display: inline-block;
        margin: 400px 10% 400px 10%;
    }

    #chapter2, #chapter3 {
        width: 100%;
        margin: 400px 0px 400px 0px;
    }

    #chapter1 .arrow {
        margin-top: 20px;
    }

    .chapter .about {
        width: 70%;
        margin: auto;
        font-size: 22px;
        padding-top: 10px;
        padding-bottom: 10px;
    }

    .about a {
        text-decoration: underline;
    }

    .visual {
        max-height: 200px;
        margin-top: 30px;
        margin-bottom: 30px;
        border: solid 2px black;
        border-radius: 50%;
        opacity: 0.7;
    }

    ul {
        text-align: left;
        font-size: 22px;
    }

    .chapter p.listTitle {
        text-align: left;
    }
</style>