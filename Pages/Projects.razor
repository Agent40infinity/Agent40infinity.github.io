@page "/projects"
@inject HttpClient http
@inject IJSRuntime js

<script src='js/SubPage.js'></script>

<VolumeSlider />
<Return />
<Header Toggled="true" />

<main class="content">
    <ProjectContainer Projects="@AllProjects" />
</main>

<Footer />

@code {
    public List<Project> AllProjects = new List<Project>();

    protected override async Task OnInitializedAsync()
    {
        var ProjectTypes = await http.GetFromJsonAsync<Dictionary<string, List<Project>>>("Data/Projects.json");
        AllProjects = ProjectTypes["professional"];
        AllProjects.AddRange(ProjectTypes["personal"]);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            Console.WriteLine("Rendered");
            await js.InvokeVoidAsync("Rendered", Navigation.duration);
        }

        await base.OnAfterRenderAsync(firstRender);
    }
}