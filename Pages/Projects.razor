@page "/projects"
@inject HttpClient http
@inject IJSRuntime js

<script src='js/SubPage.js'></script>

<VolumeSlider />
<Return />
<Header Toggled="true" />

<main class="content">
    <ProjectContainer Projects="@AllProjects" />
</main>

<Footer />

@code {
    public List<Project> AllProjects = new List<Project>();

    protected override async Task OnInitializedAsync()
    {
        if (Data.Projects != null)
        {
            #pragma warning disable CS8601
            Data.Projects = await http.GetFromJsonAsync<List<Project>>("Data/Projects.json");
            #pragma warning restore CS8601
        }

        AllProjects = Data.Projects.OrderByDescending(p => p.startDate).ToList();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            Console.WriteLine("Rendered");
            await js.InvokeVoidAsync("Rendered", Navigation.duration);
        }

        await base.OnAfterRenderAsync(firstRender);
    }
}