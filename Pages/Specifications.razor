@page "/projects/{Title}"
@inject IJSRuntime js
@inject HttpClient http
@using System.Reflection;

<script src='js/SubPage.js'></script>

<VolumeSlider />
<Return />
<Header Toggled="true" />

@if (selectedType != null)
{
    <div class="main-container">
        <div class="main-box">
            <h3 class="title">@Title</h3>
            @renderFragment
        </div>
        @if (Data.Specifications != null && Data.Specifications.Count != 0)
        {
            <div class="main-details">
                <p class="main-details-title">Details</p>
                <div class="main-details-company main-details-flex">
                    <p class="main-details-subtitle">Company:</p>
                    <p>@Data.Specifications[specIndex].company</p>
                </div>
                <div class="main-details-dates main-details-flex">
                    <p class="main-details-subtitle">Date:</p>
                    <p>@Data.Specifications[specIndex].dates</p>
                </div>
                <div class="main-details-dates main-details-flex">
                    <p class="main-details-subtitle">Duration:</p>
                    <p>@Data.Specifications[specIndex].duration</p>
                </div>
                <div class="main-details-emgine">

                </div>
                <div class="main-details-languages">

                </div>
                <div class="main-details-role">

                </div>
                <p class="main-details-subtitle" style="text-align: left">Links:</p>
                <div class="mini-list">
                    @foreach (var link in Data.Specifications[specIndex].link)
                    {
                        var linkName = @link.Replace("https://", "").Split("/")[0];
                        var favicon = "https://" + @linkName + "/favicon.ico";

                        <a href="@link" target="_blank"><img class="mini-socials main-details-ico" src="@favicon" alt="@linkName"></a>
                    }
                </div>
            </div>
        }
    </div>
}
else
{
    <div class="specifications">
        <p class="title">In Progress!</p>
        <p class="subtext">Check back later for more details.</p>
    </div>
}

<Footer />

<script>
    function OnFooterLoaded() {
        console.log($('body').height());

        if ($('body').height() < screen.height) {
            $('footer').css({ position: 'fixed', bottom: 0, width: "100%" });
        }
    }
</script>

@code {
    [Parameter]
    public string Title { get; set; } = "";

    private int specIndex;

    Type[] components => Assembly
        .GetExecutingAssembly()
        .GetTypes()
        .Where(t => t.BaseType == typeof(ComponentBase))
        .ToArray();

    Type? selectedType;

    RenderFragment? renderFragment;

    protected override void OnInitialized()
    {
        selectedType = components.Where(t => t.Name.ToUpper() == Title.ToUpper()).FirstOrDefault();

        if (selectedType == null)
        {
            return;
        }

        renderFragment = (builder) =>
        {
            builder.OpenComponent(0, selectedType);
            builder.CloseComponent();
        };
    }

    protected override async Task OnInitializedAsync()
    {
        if (Data.Specifications != null)
        {
            #pragma warning disable CS8601
            Data.Specifications = await http.GetFromJsonAsync<List<ProjectSpecs>>("Data/Specifications.json");
            #pragma warning restore CS8601

            #pragma warning disable CS8602
            specIndex = Data.Specifications.FindIndex(s => s.project == Title.Replace("-", " "));
            #pragma warning restore CS8602
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            while (Data.Specifications == null || Data.Specifications.Count == 0)
            {
                await Task.Delay(100);
            }

            await js.InvokeVoidAsync("Rendered", Navigation.duration);
            await js.InvokeVoidAsync("OnFooterLoaded");
        }

        await base.OnAfterRenderAsync(firstRender);
    }
}

