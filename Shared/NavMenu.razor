@inject NavigationManager NavManager
@inject IJSRuntime js

<div class="hamburger-nav" id="ham-nav">
    <div class="nav-left">
        <a @onclick="@(() => Navigation.NavigateTo(NavManager, js, "/"))">Home</a>
        <a @onclick="@(() => Navigation.NavigateTo(NavManager, js, "/projects"))">Projects</a>
        <a onclick="ToBottom()">Contact Me</a>
        <a @onclick="@(() => Navigation.NavigateTo(NavManager, js, "/projects/Resume"))">Resume</a>
    </div>
    <div class="nav-right">
        <img class="pfp" src="Resources/avatar.jpg" alt="It's Me.'" style="">
        <p class="about">
            Hi I'm Aiden, A Game Developer and Software Engineer previously known as Agent40.
        </p>
        <div class="mini-list">
            <a href="mailto: me@aiden.fyi" target="_blank"><img class="mini-socials" src="../Resources/SVGs/Email.svg" alt="Email"></a>
            <a href="@youtubeString" target="_blank"><img class="mini-socials" src="../Resources/SVGs/Youtube.svg" alt="Youtube"></a>
            <a href="https://github.com/Agent40infinity" target="_blank"><img class="mini-socials" src="../Resources/SVGs/Github.svg" alt="Github"></a>
            <a href="https://www.linkedin.com/in/aiden-nathan-agent40/" target="_blank"><img class="mini-socials" src="../Resources/SVGs/LinkedIn.svg" alt="LinkedIn"></a>
            <a href="https://twitter.com/Agent40infinity/" target="_blank"><img class="mini-socials" src="../Resources/SVGs/Twitter.svg" alt="Twitter"></a>
            <a href="https://www.instagram.com/agent40infinity/" target="_blank"><img class="mini-socials" src="../Resources/SVGs/Instagram.svg" alt="Instagram"></a>
        </div>
    </div>
</div>

@code {
    private const string youtubeString = "https://www.youtube.com/@agent4084";
}

<style>
    .hamburger-nav {
        position: fixed;
        display: flex;
        justify-content: left;
        flex-direction: row;
        top: 0px;
        left: 0px;
        height: 100%;
        width: 0px;
        background-color: rgb(26, 26, 26);
        z-index: 9;
        padding-top: 110px;
        overflow-x: hidden;
        transition: all 0.5s;
    }

    .hamburger-nav a {
        width: 100%;
        padding: 15px; /* 15px 15px 10px 15px; */
        text-decoration: none;
        font-size: 28px; /* 20px */
        color: white;
        display: block;
        cursor: pointer;
    }

    .hamburger-nav a:hover {
        filter: invert(71%) sepia(3%) saturate(25%) hue-rotate(332deg) brightness(89%) contrast(97%);
    }

    .nav-left {
        width: 30%;

        display: flex;
        justify-content: left;
        flex-direction: column;
    }

    .nav-right {
        width: 70%;
        text-align: center;
    }

    .nav-right .about {
        color: white;
        margin: 0 10px 20px 10px;
        font-size: 20px;
    }

    .pfp {
        max-height: 125px;
        margin-top: 30px;
        margin-bottom: 30px;
        border: solid 2px black;
        border-radius: 50%;
    }

    .mini-list {
        display: flex;
        justify-content: center;
        flex-direction: row;
    }

    .mini-list a {
        width: 30px;
        padding: 5px;
    }

    .mini-socials {
        height: 23px;
        width: 23px;
        filter: invert(100%);
        cursor: pointer;
    }

    .mini-socials:hover {
        filter: invert(71%) sepia(3%) saturate(25%) hue-rotate(332deg) brightness(89%) contrast(97%);
    }
</style>